# Staging placeholders only. Never put real credentials in this file.
# Copy to the hosting secret manager / env injection — do not bake into images.
# Staging must not share production DATABASE_URL, REDIS_URL, buckets, or secrets.

NODE_ENV=production
CHAINPORT_DB_PURPOSE=staging

# Dedicated staging catalog. TLS and strong unique credentials. Not localhost.
DATABASE_URL=postgresql://STAGING_DB_USER:STAGING_DB_PASSWORD@STAGING_DB_HOST:5432/chainport_staging?sslmode=require
REDIS_URL=rediss://:STAGING_REDIS_PASSWORD@STAGING_REDIS_HOST:6379

API_HOST=0.0.0.0
API_PORT=3001
LOG_LEVEL=info

# Public HTTPS origin. Do not hardcode a product domain here.
WEB_ORIGIN=https://STAGING_WEB_HOST
# Same-origin browser routing through the reverse proxy. Must be HTTPS or a path.
NEXT_PUBLIC_API_URL=/backend
# Server-side rewrite target (private API). Not public.
API_INTERNAL_URL=http://api:3001

AUTH_PROVIDER=oidc
SESSION_SECRET=STAGING_SESSION_SECRET_AT_LEAST_32_CHARACTERS
SESSION_TTL_SECONDS=43200
OIDC_ISSUER=https://STAGING_OIDC_ISSUER
OIDC_CLIENT_ID=STAGING_OIDC_CLIENT_ID
OIDC_CLIENT_SECRET=STAGING_OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=https://STAGING_WEB_HOST/backend/v1/auth/oidc/callback

# Object storage is required to boot production-mode processes.
# The live S3/R2 transport is still OBJECT_STORAGE_GATE_PENDING.
ARTIFACT_STORE=s3
S3_BUCKET=STAGING_ARTIFACT_BUCKET
S3_ENDPOINT=https://STAGING_S3_ENDPOINT
S3_REGION=STAGING_S3_REGION
S3_ACCESS_KEY_ID=STAGING_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=STAGING_S3_SECRET_ACCESS_KEY

# First staging bring-up: public repos + validation only.
ENABLE_VALIDATION=true
ENABLE_TESTNET_DEPLOYMENT=false
ENABLE_PRIVATE_REPOS=false

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# Designate a staging-only funder. Do not reuse a future production wallet.
CHAINPORT_TESTNET_FUNDER_PRIVATE_KEY=
ETHERSCAN_API_KEY=

WORKER_ID=
WORKSPACE_ROOT=/var/lib/chainport/workspaces
ARTIFACT_ROOT=/var/lib/chainport/artifacts
CLONE_TIMEOUT_MS=60000
CLONE_MAX_BYTES=104857600
ANALYSIS_TIMEOUT_MS=120000
ANALYSIS_MAX_FILES=8000
ANALYSIS_MAX_FILE_BYTES=524288
ANALYSIS_MAX_TOTAL_BYTES=20971520
ANALYSIS_MAX_DEPTH=20
VALIDATION_INSTALL_TIMEOUT_MS=180000
VALIDATION_BUILD_TIMEOUT_MS=180000
VALIDATION_TEST_TIMEOUT_MS=180000
VALIDATION_TOTAL_TIMEOUT_MS=600000
VALIDATION_MEMORY_BYTES=2147483648
VALIDATION_CPUS=2
VALIDATION_PIDS=256
VALIDATION_LOG_STEP_BYTES=262144
VALIDATION_LOG_TOTAL_BYTES=1048576
SANDBOX_IMAGE_FOUNDRY=chainport/sandbox-foundry:1
SANDBOX_IMAGE_NODE20=chainport/sandbox-node20:1
SANDBOX_IMAGE_NODE22=chainport/sandbox-node22:1
DEPLOYMENT_TIMEOUT_MS=300000
DEPLOYMENT_MEMORY_BYTES=2147483648
DEPLOYMENT_CPUS=2
DEPLOYMENT_PIDS=256
MAX_DEPLOYMENT_TX_COUNT=12
MAX_DEPLOYMENT_GAS=15000000
MAX_TESTNET_FUNDING_WEI=50000000000000000
MAX_TRANSACTION_VALUE_WEI=0
RPC_PROXY_MAX_BODY_BYTES=1048576
RPC_PROXY_RATE_LIMIT=120
RPC_PROXY_TIMEOUT_MS=30000
ARTIFACT_RETENTION_DAYS=90
VALIDATION_LOG_RETENTION_DAYS=30
FAILED_WORKSPACE_RETENTION_HOURS=1
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_MUTATION_PER_MINUTE=30
