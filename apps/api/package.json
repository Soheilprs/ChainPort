{
  "name": "@chainport/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsc -b",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@chainport/chain-registry": "workspace:*",
    "@chainport/db": "workspace:*",
    "@chainport/shared": "workspace:*",
    "@fastify/cors": "11.1.0",
    "fastify": "5.6.2",
    "ioredis": "5.8.2",
    "pino": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1"
  }
}
