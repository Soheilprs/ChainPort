FROM ghcr.io/foundry-rs/foundry:stable@sha256:043752653d5be351c71709091b3db97c4421c907eb40ea294195e7f532aadf46 AS foundry

FROM debian:bookworm-slim@sha256:abd67ffcfa541b485a3dff59865ab629aa048a6c613e639d36e7456b0b229241
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git coreutils curl \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 10001 chainport \
  && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/chainport chainport \
  && mkdir -p /workspace \
  && chown chainport:chainport /workspace /home/chainport
COPY --from=foundry /usr/local/bin/forge /usr/local/bin/forge
COPY --from=foundry /usr/local/bin/cast /usr/local/bin/cast
COPY --from=foundry /usr/local/bin/anvil /usr/local/bin/anvil
RUN mkdir -p /tmp/warmup/src \
  && printf '[profile.default]\nsrc = "src"\nout = "out"\nsolc = "0.8.24"\n' > /tmp/warmup/foundry.toml \
  && printf '// SPDX-License-Identifier: MIT\npragma solidity ^0.8.24;\ncontract Warmup {}\n' > /tmp/warmup/src/Warmup.sol \
  && cd /tmp/warmup && forge build \
  && mkdir -p /usr/local/svm \
  && cp -a /root/.svm/. /usr/local/svm/ \
  && chmod -R a+rX /usr/local/svm \
  && rm -rf /tmp/warmup
USER 10001:10001
WORKDIR /workspace
ENV HOME=/tmp/home
ENV SVM_HOME=/usr/local/svm
ENV FOUNDRY_DISABLE_NIGHTLY_WARNING=1
