generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationKind {
  NETWORK
  FOUNDATION
  ECOSYSTEM
  RAAS
  INTERNAL
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum RepositoryProvider {
  GITHUB
}

enum CloneStatus {
  PENDING
  CLONING
  READY
  FAILED
}

enum JobStatus {
  QUEUED
  INGESTING
  ANALYZING
  COMPARING
  PLANNING
  PATCHING
  BUILDING
  TESTING
  DEPLOYING
  VERIFYING
  COMPLETED
  FAILED
  CANCELLED
}

enum FindingSeverity {
  PASS
  WARNING
  BLOCKER
}

enum AnalysisStatus {
  QUEUED
  MATERIALIZING
  INVENTORYING
  ANALYZING
  COMPLETED
  FAILED
}

enum FileCategory {
  SOLIDITY
  TYPESCRIPT
  JAVASCRIPT
  JSON
  TOML
  YAML
  MARKDOWN
  ENV_TEMPLATE
  CONFIG
  OTHER
}

enum RequirementCategory {
  NETWORK
  TOKEN
  ORACLE
  PROTOCOL
  CROSS_CHAIN
  RPC
  FRONTEND
  CONFIGURATION
  FRAMEWORK
}

enum DetectionConfidence {
  DETECTED
  LIKELY
  UNKNOWN
}

enum ComponentKind {
  FRAMEWORK
  LANGUAGE
  PACKAGE_MANAGER
  CONTRACT
  INTERFACE
  LIBRARY
  FRONTEND
  DEPENDENCY
}

enum DetectorRunStatus {
  COMPLETED
  FAILED
}

enum FindingCategory {
  CHAIN_ID
  HARDCODED_ADDRESS
  RPC
  TOKEN
  ORACLE
  BRIDGE
  PRECOMPILE
  OPCODE
  FRAMEWORK
  DEPENDENCY
  FRONTEND_CONFIG
  PROTOCOL
  GAS
  FINALITY
  INFRASTRUCTURE
  OTHER
}

model Organization {
  id        String           @id @db.Uuid
  name      String
  slug      String           @unique
  kind      OrganizationKind
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users     User[]
  projects  Project[]

  @@map("organizations")
}

model User {
  id             String        @id @db.Uuid
  email          String        @unique
  name           String?
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@map("users")
}

model Repository {
  id                 String             @id @db.Uuid
  provider           RepositoryProvider @default(GITHUB)
  owner              String
  name               String
  normalizedUrl      String             @map("normalized_url")
  defaultBranch      String?            @map("default_branch")
  resolvedCommitSha  String?            @map("resolved_commit_sha")
  cloneStatus        CloneStatus        @default(PENDING) @map("clone_status")
  clonedAt           DateTime?          @map("cloned_at") @db.Timestamptz(3)
  sizeBytes          BigInt?            @map("size_bytes")
  ingestErrorCode    String?            @map("ingest_error_code")
  ingestErrorMessage String?            @map("ingest_error_message")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects           Project[]
  jobs               MigrationJob[]
  analyses           RepositoryAnalysis[]

  @@unique([provider, owner, name])
  @@map("repositories")
}

model Project {
  id             String        @id @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  repositoryId   String        @map("repository_id") @db.Uuid
  repository     Repository    @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  name           String
  githubUrl      String        @map("github_url")
  githubOwner    String        @map("github_owner")
  githubRepo     String        @map("github_repo")
  defaultBranch  String        @default("main") @map("default_branch")
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobs           MigrationJob[]
  analyses       RepositoryAnalysis[]

  @@unique([githubOwner, githubRepo])
  @@unique([repositoryId])
  @@index([organizationId])
  @@map("projects")
}

model MigrationJob {
  id             String           @id @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId   String           @map("repository_id") @db.Uuid
  repository     Repository       @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  sourceChainKey String           @map("source_chain_key")
  targetChainKey String           @map("target_chain_key")
  repoSha        String?          @map("repo_sha")
  status         JobStatus        @default(QUEUED)
  attempt        Int              @default(0)
  maxAttempts    Int              @default(3) @map("max_attempts")
  idempotencyKey String           @unique @map("idempotency_key")
  leaseOwner     String?          @map("lease_owner")
  leaseExpiresAt DateTime?        @map("lease_expires_at") @db.Timestamptz(3)
  errorCode      String?          @map("error_code")
  errorMessage   String?          @map("error_message")
  startedAt      DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?        @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  findings       Finding[]
  plan           MigrationPlan?
  sandboxRuns    SandboxRun[]
  deployments    Deployment[]
  statusEvents   JobStatusEvent[]

  @@index([status, createdAt])
  @@index([projectId])
  @@index([repositoryId])
  @@map("migration_jobs")
}

model JobStatusEvent {
  id         String     @id @db.Uuid
  jobId      String     @map("job_id") @db.Uuid
  job        MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus JobStatus? @map("from_status")
  toStatus   JobStatus  @map("to_status")
  reason     String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([jobId, createdAt])
  @@map("job_status_events")
}

model Finding {
  id          String          @id @db.Uuid
  jobId       String          @map("job_id") @db.Uuid
  job         MigrationJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  code        String
  severity    FindingSeverity
  category    FindingCategory
  title       String
  description String
  filePath    String?         @map("file_path")
  evidence    Json
  remediation String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([jobId, severity])
  @@map("findings")
}

model MigrationPlan {
  id        String       @id @db.Uuid
  jobId     String       @unique @map("job_id") @db.Uuid
  job       MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  summary   String
  steps     Json
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("migration_plans")
}

model SandboxRun {
  id          String       @id @db.Uuid
  jobId       String       @map("job_id") @db.Uuid
  job         MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      JobStatus
  imageDigest String?      @map("image_digest")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([jobId])
  @@map("sandbox_runs")
}

model Deployment {
  id              String       @id @db.Uuid
  jobId           String       @map("job_id") @db.Uuid
  job             MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  targetChainKey  String       @map("target_chain_key")
  transactionHash String?      @map("transaction_hash")
  contractAddress String?      @map("contract_address")
  verified        Boolean      @default(false)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([jobId])
  @@map("deployments")
}

model RepositoryAnalysis {
  id                 String                 @id @db.Uuid
  projectId          String                 @map("project_id") @db.Uuid
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId       String                 @map("repository_id") @db.Uuid
  repository         Repository             @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  commitSha          String                 @map("commit_sha")
  scannerVersion     String                 @map("scanner_version")
  status             AnalysisStatus         @default(QUEUED)
  idempotencyKey     String                 @unique @map("idempotency_key")
  fileCount          Int                    @default(0) @map("file_count")
  analyzedFileCount  Int                    @default(0) @map("analyzed_file_count")
  skippedFileCount   Int                    @default(0) @map("skipped_file_count")
  totalAnalyzedBytes Int                    @default(0) @map("total_analyzed_bytes")
  errorCode          String?                @map("error_code")
  errorMessage       String?                @map("error_message")
  startedAt          DateTime?              @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  statusEvents       AnalysisStatusEvent[]
  detectorRuns       AnalysisDetectorRun[]
  files              RepositoryFile[]
  components         RepositoryComponent[]
  requirements       ProjectRequirement[]
  evidence           AnalysisEvidence[]

  @@unique([repositoryId, commitSha, scannerVersion])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("repository_analyses")
}

model AnalysisStatusEvent {
  id         String             @id @db.Uuid
  analysisId String             @map("analysis_id") @db.Uuid
  analysis   RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fromStatus AnalysisStatus?    @map("from_status")
  toStatus   AnalysisStatus     @map("to_status")
  reason     String?
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([analysisId, createdAt])
  @@map("analysis_status_events")
}

model AnalysisDetectorRun {
  id           String             @id @db.Uuid
  analysisId   String             @map("analysis_id") @db.Uuid
  analysis     RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  detectorId   String             @map("detector_id")
  detectorVersion String          @map("detector_version")
  status       DetectorRunStatus
  durationMs   Int                @map("duration_ms")
  errorMessage String?            @map("error_message")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([analysisId])
  @@map("analysis_detector_runs")
}

model RepositoryFile {
  id         String             @id @db.Uuid
  analysisId String             @map("analysis_id") @db.Uuid
  analysis   RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  path       String
  extension  String
  category   FileCategory
  sizeBytes  Int                @map("size_bytes")
  analyzed   Boolean
  skipReason String?            @map("skip_reason")

  @@index([analysisId, category])
  @@map("repository_files")
}

model RepositoryComponent {
  id         String             @id @db.Uuid
  analysisId String             @map("analysis_id") @db.Uuid
  analysis   RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  kind       ComponentKind
  name       String
  detail     String?
  filePath   String?            @map("file_path")

  @@index([analysisId, kind])
  @@map("repository_components")
}

model ProjectRequirement {
  id              String               @id @db.Uuid
  analysisId      String               @map("analysis_id") @db.Uuid
  analysis        RepositoryAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  category        RequirementCategory
  key             String
  requirementType String               @map("requirement_type")
  detectedValue   String               @map("detected_value")
  normalizedValue String               @map("normalized_value")
  confidence      DetectionConfidence
  detector        String
  detectorVersion String               @map("detector_version")
  evidence        AnalysisEvidence[]

  @@index([analysisId, category])
  @@index([analysisId, key])
  @@map("project_requirements")
}

model AnalysisEvidence {
  id            String              @id @db.Uuid
  analysisId    String              @map("analysis_id") @db.Uuid
  analysis      RepositoryAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  requirementId String?             @map("requirement_id") @db.Uuid
  requirement   ProjectRequirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  filePath      String              @map("file_path")
  startLine     Int                 @map("start_line")
  endLine       Int                 @map("end_line")
  evidenceType  String              @map("evidence_type")
  excerpt       String

  @@index([analysisId])
  @@index([requirementId])
  @@map("analysis_evidence")
}
