generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationKind {
  NETWORK
  FOUNDATION
  ECOSYSTEM
  RAAS
  INTERNAL
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum DataClassification {
  PRODUCTION
  INTERNAL_TEST
}

enum NetworkPartnerStatus {
  ACTIVE
  PAUSED
  PILOT
  DISABLED
}

enum AcquisitionSource {
  GENERIC_PORTAL
  PARTNER_PORTAL
  INTERNAL
  API
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum RepositoryVisibility {
  PUBLIC
  PRIVATE
}

enum AuditAction {
  LOGIN
  LOGOUT
  PROJECT_CREATED
  PROJECT_ARCHIVED
  PRIVATE_REPO_CONNECTED
  ANALYSIS_STARTED
  CHANGESET_FINALIZED
  VALIDATION_STARTED
  DEPLOYMENT_PREPARED
  DEPLOYMENT_CONFIRMED
  DEPLOYMENT_COMPLETED
  PARTNER_SETTINGS_UPDATED
  MEMBER_ADDED
  ROLE_CHANGED
  ACCESS_DENIED
}

enum RepositoryProvider {
  GITHUB
}

enum CloneStatus {
  PENDING
  CLONING
  READY
  FAILED
}

enum JobStatus {
  QUEUED
  INGESTING
  ANALYZING
  COMPARING
  PLANNING
  PATCHING
  BUILDING
  TESTING
  DEPLOYING
  VERIFYING
  COMPLETED
  FAILED
  CANCELLED
}

enum FindingSeverity {
  PASS
  WARNING
  BLOCKER
}

enum AnalysisStatus {
  QUEUED
  MATERIALIZING
  INVENTORYING
  ANALYZING
  COMPLETED
  FAILED
}

enum FileCategory {
  SOLIDITY
  TYPESCRIPT
  JAVASCRIPT
  JSON
  TOML
  YAML
  MARKDOWN
  ENV_TEMPLATE
  CONFIG
  OTHER
}

enum RequirementCategory {
  NETWORK
  TOKEN
  ORACLE
  PROTOCOL
  CROSS_CHAIN
  RPC
  FRONTEND
  CONFIGURATION
  FRAMEWORK
}

enum DetectionConfidence {
  DETECTED
  LIKELY
  UNKNOWN
}

enum ComponentKind {
  FRAMEWORK
  LANGUAGE
  PACKAGE_MANAGER
  CONTRACT
  INTERFACE
  LIBRARY
  FRONTEND
  DEPENDENCY
}

enum DetectorRunStatus {
  COMPLETED
  FAILED
}

enum CompatibilityRunStatus {
  QUEUED
  EVALUATING
  COMPLETED
  FAILED
}

enum CompatibilityFindingStatus {
  PASS
  WARNING
  BLOCKER
  UNKNOWN
}

enum CompatibilityCategory {
  CONTRACTS
  RPC
  TOKENS
  ORACLES
  PROTOCOLS
  CROSS_CHAIN
  FRONTEND
  CONFIGURATION
}

enum CompatibilityReadiness {
  READY
  REVIEW_REQUIRED
  BLOCKED
  INSUFFICIENT_DATA
}

enum MigrationPlanRunStatus {
  QUEUED
  PLANNING
  COMPLETED
  FAILED
}

enum MigrationPlanOutcome {
  READY_TO_APPLY
  REVIEW_REQUIRED
  BLOCKED
  NEEDS_VERIFICATION
}

enum MigrationAutomationLevel {
  SAFE_AUTOMATIC
  REVIEW_REQUIRED
  MANUAL
  BLOCKED
  UNKNOWN
}

enum MigrationRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MigrationActionStatus {
  PLANNED
  BLOCKED
  UNKNOWN
}

enum MigrationStage {
  NETWORK_CONFIGURATION
  RPC_AND_EXPLORER
  TOKEN_MAPPINGS
  INFRASTRUCTURE_CONTRACTS
  ORACLES
  CROSS_CHAIN
  CONTRACT_CONFIGURATION
  FRONTEND_CONFIGURATION
  DEPLOYMENT_CONFIGURATION
  MANUAL_REVIEW
}

enum ChangeSetStatus {
  QUEUED
  MATERIALIZING
  GENERATING
  READY_FOR_REVIEW
  FINALIZING
  FINALIZED
  FAILED
  ROLLED_BACK
}

enum ChangeStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SKIPPED
  FAILED
}

enum ChangeType {
  REPLACE_VALUE
}

enum RevisionType {
  ORIGINAL
  GENERATED
}

enum RevisionCompleteness {
  COMPLETE
  PARTIAL
}

enum ValidationRunStatus {
  QUEUED
  PREPARING
  INSTALLING
  BUILDING
  TESTING
  COMPLETED
  FAILED
  TIMED_OUT
}

enum ValidationOutcome {
  PASSED
  FAILED
  PARTIAL
  UNSUPPORTED
  INFRA_FAILURE
}

enum ValidationStepName {
  MATERIALIZE
  VERIFY_REVISION
  INSTALL
  BUILD
  TEST
  CLEANUP
}

enum ValidationStepStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  SKIPPED
  TIMED_OUT
}

enum ValidationFramework {
  FOUNDRY
  HARDHAT
}

enum ValidationProfile {
  STANDARD_LOCAL
}

enum DeploymentRunStatus {
  QUEUED
  CHECKING_ELIGIBILITY
  PREPARING
  FUNDING
  SIMULATING
  PREPARED
  BROADCASTING
  CONFIRMING
  VERIFYING
  COMPLETED
  FAILED
  RECONCILIATION_REQUIRED
  CANCELLED
}

enum DeploymentProfile {
  TESTNET_DEPLOY
}

enum DeploymentFramework {
  FOUNDRY
  HARDHAT
}

enum DeploymentPreflightStatus {
  PENDING
  PASSED
  FAILED
  SKIPPED
}

enum DeploymentTransactionStatus {
  SUBMITTED
  PENDING
  CONFIRMED
  REVERTED
  UNKNOWN
}

enum DeploymentSourceVerificationStatus {
  VERIFIED
  FAILED
  NOT_SUPPORTED
  NOT_CONFIGURED
  SKIPPED
}

enum DeploymentCheckStatus {
  PASSED
  FAILED
  SKIPPED
}

enum DeploymentCandidateConfidence {
  DETECTED
  LIKELY
  UNKNOWN
}

enum MigrationActionCategory {
  CHAIN_ID
  RPC_URL
  EXPLORER
  ENV_CONFIG
  TOKEN_ADDRESS
  INFRASTRUCTURE_ADDRESS
  ORACLE_FEED
  RPC_CAPABILITY
  CROSS_CHAIN
  FRONTEND_NETWORK
  UNKNOWN_ADDRESS
  BLOCKED_INFRASTRUCTURE
}

enum RemediationType {
  NONE
  CONFIG_CHANGE
  ADDRESS_MAPPING
  INFRASTRUCTURE_REQUIRED
  MANUAL_REVIEW
  UNKNOWN
}

enum FindingCategory {
  CHAIN_ID
  HARDCODED_ADDRESS
  RPC
  TOKEN
  ORACLE
  BRIDGE
  PRECOMPILE
  OPCODE
  FRAMEWORK
  DEPENDENCY
  FRONTEND_CONFIG
  PROTOCOL
  GAS
  FINALITY
  INFRASTRUCTURE
  OTHER
}

model Organization {
  id              String                    @id @db.Uuid
  name            String
  slug            String                    @unique
  kind            OrganizationKind
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  users           User[]
  memberships     OrganizationMembership[]
  projects        Project[]
  ownedProjects   Project[]                 @relation("ProjectOwnerOrganization")
  networkPartners NetworkPartner[]
  auditEvents     AuditEvent[]

  @@map("organizations")
}

model NetworkPartner {
  id                     String               @id @db.Uuid
  organizationId         String               @map("organization_id") @db.Uuid
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  networkKey             String               @map("network_key")
  slug                   String               @unique
  displayName            String               @map("display_name")
  status                 NetworkPartnerStatus @default(ACTIVE)
  isDemo                 Boolean              @default(false) @map("is_demo")
  logoUrl                String?              @map("logo_url")
  primaryAccent          String?              @map("primary_accent")
  shortDescription       String?              @map("short_description")
  developerPortalEnabled Boolean              @default(true) @map("developer_portal_enabled")
  docsUrl                String?              @map("docs_url")
  faucetUrl              String?              @map("faucet_url")
  explorerUrl            String?              @map("explorer_url")
  supportUrl             String?              @map("support_url")
  discordUrl             String?              @map("discord_url")
  developerDocsUrl       String?              @map("developer_docs_url")
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects               Project[]

  @@unique([organizationId, networkKey])
  @@index([networkKey])
  @@index([status])
  @@map("network_partners")
}

model User {
  id                 String                    @id @db.Uuid
  email              String                    @unique
  name               String?
  organizationId     String?                   @map("organization_id") @db.Uuid
  organization       Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  issuer             String?
  subject            String?
  isPlatformAdmin    Boolean                   @default(false) @map("is_platform_admin")
  lastLoginAt        DateTime?                 @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        OrganizationMembership[]
  sessions           Session[]
  ownedProjects      Project[]                 @relation("ProjectOwner")
  githubInstallations GitHubInstallation[]
  auditEvents        AuditEvent[]

  @@unique([issuer, subject])
  @@index([organizationId])
  @@map("users")
}

model OrganizationMembership {
  id             String           @id @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String           @map("organization_id") @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

model Session {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique @map("token_hash")
  csrfHash      String    @map("csrf_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedFromId String?   @map("rotated_from_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ip            String?
  userAgent     String?   @map("user_agent")

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id             String        @id @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projectId      String?       @map("project_id") @db.Uuid
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  action         AuditAction
  targetType     String        @map("target_type")
  targetId       String?       @map("target_id")
  requestId      String?       @map("request_id")
  metadata       Json
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

model GitHubInstallation {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String    @map("installation_id")
  accountLogin   String    @map("account_login")
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  repositories   Repository[]

  @@unique([userId, installationId])
  @@index([installationId])
  @@map("github_installations")
}

model Repository {
  id                     String                @id @db.Uuid
  provider               RepositoryProvider    @default(GITHUB)
  owner                  String
  name                   String
  normalizedUrl          String                @map("normalized_url")
  visibility             RepositoryVisibility  @default(PUBLIC)
  githubInstallationDbId String?               @map("github_installation_db_id") @db.Uuid
  githubInstallation     GitHubInstallation?   @relation(fields: [githubInstallationDbId], references: [id], onDelete: SetNull)
  defaultBranch          String?               @map("default_branch")
  resolvedCommitSha      String?               @map("resolved_commit_sha")
  cloneStatus            CloneStatus           @default(PENDING) @map("clone_status")
  clonedAt               DateTime?             @map("cloned_at") @db.Timestamptz(3)
  sizeBytes              BigInt?               @map("size_bytes")
  ingestErrorCode        String?               @map("ingest_error_code")
  ingestErrorMessage     String?               @map("ingest_error_message")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  projects            Project[]
  jobs                MigrationJob[]
  analyses            RepositoryAnalysis[]
  compatibilityRuns   CompatibilityRun[]
  plannedMigrations   PlannedMigration[]
  revisions           RepositoryRevision[]
  changeSets          ChangeSet[]

  @@unique([provider, owner, name])
  @@map("repositories")
}

model Project {
  id                   String              @id @db.Uuid
  organizationId       String?             @map("organization_id") @db.Uuid
  organization         Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  ownerUserId          String?             @map("owner_user_id") @db.Uuid
  ownerUser            User?               @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerOrganizationId  String?             @map("owner_organization_id") @db.Uuid
  ownerOrganization    Organization?       @relation("ProjectOwnerOrganization", fields: [ownerOrganizationId], references: [id], onDelete: SetNull)
  repositoryId         String              @map("repository_id") @db.Uuid
  repository           Repository          @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  name                 String
  githubUrl            String              @map("github_url")
  githubOwner          String              @map("github_owner")
  githubRepo           String              @map("github_repo")
  defaultBranch        String              @default("main") @map("default_branch")
  status               ProjectStatus       @default(ACTIVE)
  dataClassification   DataClassification  @default(PRODUCTION) @map("data_classification")
  networkPartnerId   String?             @map("network_partner_id") @db.Uuid
  networkPartner     NetworkPartner?     @relation(fields: [networkPartnerId], references: [id], onDelete: SetNull)
  acquisitionSource  AcquisitionSource   @default(GENERIC_PORTAL) @map("acquisition_source")
  referralCode       String?             @map("referral_code")
  campaign           String?
  activeRevisionId   String?             @map("active_revision_id") @db.Uuid
  activeRevision     RepositoryRevision? @relation("ActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  jobs               MigrationJob[]
  analyses           RepositoryAnalysis[]
  compatibilityRuns  CompatibilityRun[]
  plannedMigrations  PlannedMigration[]
  revisions          RepositoryRevision[] @relation("ProjectRevisions")
  changeSets         ChangeSet[]
  validationRuns     ValidationRun[]
  deploymentRuns     DeploymentRun[]
  auditEvents        AuditEvent[]

  @@unique([githubOwner, githubRepo])
  @@unique([repositoryId])
  @@index([organizationId])
  @@index([ownerUserId])
  @@index([ownerOrganizationId])
  @@index([activeRevisionId])
  @@index([dataClassification, createdAt])
  @@index([networkPartnerId])
  @@index([acquisitionSource])
  @@map("projects")
}

model MigrationJob {
  id             String           @id @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId   String           @map("repository_id") @db.Uuid
  repository     Repository       @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  sourceChainKey String           @map("source_chain_key")
  targetChainKey String           @map("target_chain_key")
  repoSha        String?          @map("repo_sha")
  status         JobStatus        @default(QUEUED)
  attempt        Int              @default(0)
  maxAttempts    Int              @default(3) @map("max_attempts")
  idempotencyKey String           @unique @map("idempotency_key")
  leaseOwner     String?          @map("lease_owner")
  leaseExpiresAt DateTime?        @map("lease_expires_at") @db.Timestamptz(3)
  errorCode      String?          @map("error_code")
  errorMessage   String?          @map("error_message")
  startedAt      DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?        @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  findings       Finding[]
  plan           MigrationPlan?
  sandboxRuns    SandboxRun[]
  deployments    Deployment[]
  statusEvents   JobStatusEvent[]

  @@index([status, createdAt])
  @@index([projectId])
  @@index([repositoryId])
  @@index([targetChainKey, createdAt])
  @@map("migration_jobs")
}

model JobStatusEvent {
  id         String     @id @db.Uuid
  jobId      String     @map("job_id") @db.Uuid
  job        MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus JobStatus? @map("from_status")
  toStatus   JobStatus  @map("to_status")
  reason     String?
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([jobId, createdAt])
  @@map("job_status_events")
}

model Finding {
  id          String          @id @db.Uuid
  jobId       String          @map("job_id") @db.Uuid
  job         MigrationJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  code        String
  severity    FindingSeverity
  category    FindingCategory
  title       String
  description String
  filePath    String?         @map("file_path")
  evidence    Json
  remediation String?
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([jobId, severity])
  @@map("findings")
}

model MigrationPlan {
  id        String       @id @db.Uuid
  jobId     String       @unique @map("job_id") @db.Uuid
  job       MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  summary   String
  steps     Json
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("migration_plans")
}

model SandboxRun {
  id          String       @id @db.Uuid
  jobId       String       @map("job_id") @db.Uuid
  job         MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      JobStatus
  imageDigest String?      @map("image_digest")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([jobId])
  @@map("sandbox_runs")
}

model Deployment {
  id              String       @id @db.Uuid
  jobId           String       @map("job_id") @db.Uuid
  job             MigrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  targetChainKey  String       @map("target_chain_key")
  transactionHash String?      @map("transaction_hash")
  contractAddress String?      @map("contract_address")
  verified        Boolean      @default(false)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([jobId])
  @@map("deployments")
}

model RepositoryAnalysis {
  id                 String                 @id @db.Uuid
  projectId          String                 @map("project_id") @db.Uuid
  project            Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId       String                 @map("repository_id") @db.Uuid
  repository         Repository             @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  commitSha          String                 @map("commit_sha")
  scannerVersion     String                 @map("scanner_version")
  status             AnalysisStatus         @default(QUEUED)
  idempotencyKey     String                 @unique @map("idempotency_key")
  fileCount          Int                    @default(0) @map("file_count")
  analyzedFileCount  Int                    @default(0) @map("analyzed_file_count")
  skippedFileCount   Int                    @default(0) @map("skipped_file_count")
  totalAnalyzedBytes Int                    @default(0) @map("total_analyzed_bytes")
  errorCode          String?                @map("error_code")
  errorMessage       String?                @map("error_message")
  startedAt          DateTime?              @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?              @map("completed_at") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  statusEvents       AnalysisStatusEvent[]
  detectorRuns       AnalysisDetectorRun[]
  files              RepositoryFile[]
  components         RepositoryComponent[]
  requirements        ProjectRequirement[]
  evidence            AnalysisEvidence[]
  compatibilityRuns   CompatibilityRun[]

  @@unique([repositoryId, commitSha, scannerVersion])
  @@index([projectId, createdAt])
  @@index([status, createdAt])
  @@map("repository_analyses")
}

model AnalysisStatusEvent {
  id         String             @id @db.Uuid
  analysisId String             @map("analysis_id") @db.Uuid
  analysis   RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  fromStatus AnalysisStatus?    @map("from_status")
  toStatus   AnalysisStatus     @map("to_status")
  reason     String?
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([analysisId, createdAt])
  @@map("analysis_status_events")
}

model AnalysisDetectorRun {
  id           String             @id @db.Uuid
  analysisId   String             @map("analysis_id") @db.Uuid
  analysis     RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  detectorId   String             @map("detector_id")
  detectorVersion String          @map("detector_version")
  status       DetectorRunStatus
  durationMs   Int                @map("duration_ms")
  errorMessage String?            @map("error_message")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([analysisId])
  @@map("analysis_detector_runs")
}

model RepositoryFile {
  id         String             @id @db.Uuid
  analysisId String             @map("analysis_id") @db.Uuid
  analysis   RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  path       String
  extension  String
  category   FileCategory
  sizeBytes  Int                @map("size_bytes")
  analyzed   Boolean
  skipReason String?            @map("skip_reason")

  @@index([analysisId, category])
  @@map("repository_files")
}

model RepositoryComponent {
  id         String             @id @db.Uuid
  analysisId String             @map("analysis_id") @db.Uuid
  analysis   RepositoryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  kind       ComponentKind
  name       String
  detail     String?
  filePath   String?            @map("file_path")

  @@index([analysisId, kind])
  @@map("repository_components")
}

model ProjectRequirement {
  id              String               @id @db.Uuid
  analysisId      String               @map("analysis_id") @db.Uuid
  analysis        RepositoryAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  category        RequirementCategory
  key             String
