  deploymentRunId String               @map("deployment_run_id") @db.Uuid
  deploymentRun   DeploymentRun        @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  fromStatus      DeploymentRunStatus? @map("from_status")
  toStatus        DeploymentRunStatus  @map("to_status")
  reason          String?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([deploymentRunId, createdAt])
  @@map("deployment_status_events")
}

model DeploymentPreflight {
  id               String                    @id @db.Uuid
  deploymentRunId  String                    @unique @map("deployment_run_id") @db.Uuid
  deploymentRun    DeploymentRun             @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  transactionCount Int?                      @map("transaction_count")
  estimatedGas     String?                   @map("estimated_gas")
  estimatedCost    String?                   @map("estimated_cost")
  status           DeploymentPreflightStatus
  warnings         Json
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("deployment_preflights")
}

model DeploymentTransaction {
  id              String                       @id @db.Uuid
  deploymentRunId String                       @map("deployment_run_id") @db.Uuid
  deploymentRun   DeploymentRun                @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  sequence        Int
  hash            String
  nonce           Int?
  fromAddress     String?                      @map("from_address")
  toAddress       String?                      @map("to_address")
  value           String                       @default("0")
  gasLimit        String?                      @map("gas_limit")
  status          DeploymentTransactionStatus
  blockNumber     Int?                         @map("block_number")
  contractAddress String?                      @map("contract_address")
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  confirmedAt     DateTime?                    @map("confirmed_at") @db.Timestamptz(3)

  @@unique([deploymentRunId, hash])
  @@index([deploymentRunId, sequence])
  @@map("deployment_transactions")
}

model DeploymentContract {
  id                   String                               @id @db.Uuid
  deploymentRunId      String                               @map("deployment_run_id") @db.Uuid
  deploymentRun        DeploymentRun                        @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  address              String
  transactionHash      String                               @map("transaction_hash")
  blockNumber          Int?                                 @map("block_number")
  deployer             String?
  contractName         String?                              @map("contract_name")
  sourcePath           String?                              @map("source_path")
  bytecodePresent      Boolean                              @default(false) @map("bytecode_present")
  receiptStatus        String?                              @map("receipt_status")
  verificationStatus   DeploymentSourceVerificationStatus   @map("verification_status")
  verificationMessage  String?                              @map("verification_message")
  createdAt            DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([deploymentRunId, address])
  @@index([deploymentRunId])
  @@map("deployment_contracts")
}

model DeploymentCheck {
  id              String                @id @db.Uuid
  deploymentRunId String                @map("deployment_run_id") @db.Uuid
  deploymentRun   DeploymentRun         @relation(fields: [deploymentRunId], references: [id], onDelete: Cascade)
  name            String
  status          DeploymentCheckStatus
  detail          String
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([deploymentRunId])
  @@map("deployment_checks")
}
