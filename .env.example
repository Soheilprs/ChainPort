# Copy to .env for local development. Never commit .env files.
# Sample credentials are for the local Docker Compose services only.

NODE_ENV=development
CHAINPORT_DB_PURPOSE=development
DATABASE_URL=postgresql://chainport:chainport@localhost:5433/chainport
REDIS_URL=redis://localhost:6379

# Integration tests load .env.integration, not this file.
# CHAINPORT_DB_PURPOSE=integration-test
# DATABASE_URL=postgresql://chainport:chainport@localhost:5433/chainport_integration

API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
WORKER_ID=
WORKSPACE_ROOT=
ARTIFACT_ROOT=
VALIDATION_INSTALL_TIMEOUT_MS=180000
VALIDATION_BUILD_TIMEOUT_MS=180000
VALIDATION_TEST_TIMEOUT_MS=180000
VALIDATION_TOTAL_TIMEOUT_MS=600000
VALIDATION_MEMORY_BYTES=2147483648
VALIDATION_CPUS=2
VALIDATION_PIDS=256
VALIDATION_LOG_STEP_BYTES=262144
VALIDATION_LOG_TOTAL_BYTES=1048576
SANDBOX_IMAGE_FOUNDRY=
SANDBOX_IMAGE_NODE20=
SANDBOX_IMAGE_NODE22=
CLONE_TIMEOUT_MS=60000
CLONE_MAX_BYTES=104857600
ANALYSIS_TIMEOUT_MS=120000
ANALYSIS_MAX_FILES=8000
ANALYSIS_MAX_FILE_BYTES=524288
ANALYSIS_MAX_TOTAL_BYTES=20971520
ANALYSIS_MAX_DEPTH=20
GITHUB_API_BASE_URL=https://api.github.com
NEXT_PUBLIC_API_URL=http://localhost:3001
